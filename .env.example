# ─────────────────────────────────────────────────────────────
# Host / IP configuration for docker compose
# Change API_HOST / WEB_HOST to your machine's LAN IP (e.g. 192.168.2.158)
# to access the stack from other devices. Use "localhost" for local only.
# ─────────────────────────────────────────────────────────────

# Backend API — where the BROWSER reaches the API (baked into the FE bundle)
API_HOST=192.168.2.158
API_PORT=5000

# Frontend web app
WEB_HOST=192.168.2.158
WEB_PORT=3002

# Postgres port published on the host (container always listens on 5432)
DB_HOST_PORT=8436

# ─── Database credentials ───
DB_NAME=ot_management
DB_USER=ot
DB_PASSWORD=ot

# ─── JWT secrets (change in production) ───
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── Mail / SMTP (for forgot-password OTP) ───
# Leave MAIL_HOST blank to just log the OTP to the API console in dev.
# For Gmail use an "App password" (not your normal password).
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Seed demo data on first boot ("true"/"false")
RUN_SEED=false

# npm registry used during "docker compose build". Leave blank for the official
# registry; on slow networks (e.g. VN) a mirror is much faster:
#   NPM_REGISTRY=https://registry.npmmirror.com/
NPM_REGISTRY=
