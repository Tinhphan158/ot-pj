generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  avatar       String?
  refreshToken String?  @map("refresh_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  overtimes         Overtime[]
  overtimeAuditLogs OvertimeAuditLog[]

  @@map("users")
}

model Overtime {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  hours     Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([date])
  @@map("overtimes")
}

enum OvertimeAuditAction {
  CREATED
  UPDATED
  DELETED
}

/// One change to an overtime entry. Kept after the entry itself is deleted, so
/// `overtimeId` is deliberately not a foreign key.
model OvertimeAuditLog {
  id         String              @id @default(uuid())
  overtimeId String              @map("overtime_id")
  actorId    String?             @map("actor_id")
  actor      User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     OvertimeAuditAction
  /// The entry as it was before the change; null on CREATED.
  before     Json?
  /// The entry as it is after the change; null on DELETED.
  after      Json?
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([overtimeId])
  @@index([createdAt])
  @@map("overtime_audit_logs")
}
