# App
PORT=5000
# Comma-separated list of allowed CORS origins (add your LAN IP to access from other devices)
CORS_ORIGINS=http://localhost:3002,http://192.168.2.158:3002

# Database (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=ot
DB_PASSWORD=ot
DB_DATABASE=ot_management

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-string
JWT_REFRESH_EXPIRES_IN=7d

# Mail (optional — leave blank to log OTP to console in dev)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=OT Management <no-reply@ot.local>
